{
  "type": "minecraft:notice",
  "title": {
    "text": "Quick Actions",
    "color": "white"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "======= Players =======",
        "color": "gold"
      }
    },
    {
      "type": "minecraft:item",
      "item": {
        "id": "minecraft:ender_pearl"
      },
      "description": {
        "text": "Teleport everyone to you ",
        "click_event": {
          "action": "run_command",
          "command": "tp @a @s"
        }
      },
      "width": 1
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "======= Game =======",
        "color": "gold"
      }
    },
    {
      "type": "minecraft:item",
      "item": {
        "id": "minecraft:rabbit_foot"
      },
      "description": {
        "text": "Skip current turn ",
        "click_event": {
          "action": "run_command",
          "command": "function mineparty:game/round/turn/skip"
        }
      },
      "width": 1
    },
    {
      "type": "minecraft:item",
      "item": {
        "id": "minecraft:red_bed"
      },
      "description": {
        "text": "Pause/unpause game ",
        "click_event": {
          "action": "run_command",
          "command": "function mineparty:game/pause"
        }
      },
      "width": 1
    },
    {
      "type": "minecraft:item",
      "item": {
        "id": "minecraft:barrier"
      },
      "description": {
        "text": "Cancel game ",
        "color": "red",
        "click_event": {
          "action": "run_command",
          "command": "function mineparty:game/cancel"
        },
        "hover_event": {
          "action": "show_text",
          "value": "Cuts the game short without winner."
        }
      },
      "width": 1
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "======= Timer =======",
        "color": "gold"
      }
    },
    {
      "type": "minecraft:item",
      "item": {
        "id": "minecraft:clock"
      },
      "description": {
        "text": "Set timer ",
        "click_event": {
          "action": "show_dialog",
          "dialog": "mineparty:set_timer"
        }
      },
      "width": 1
    },
    {
      "type": "minecraft:item",
      "item": {
        "id": "minecraft:yellow_bed"
      },
      "description": {
        "text": "Pause/unpause timer ",
        "click_event": {
          "action": "run_command",
          "command": "function mineparty:timer/pause"
        }
      },
      "width": 1
    }
  ],
  "columns": 1,
  "action":
  {
    "label": "Cancel"
  }
}