$dialog show @s {"type": "minecraft:confirmation","title": {"text": "Tag Editor"},"inputs": [{"type": "minecraft:boolean","key": "no_diamond","label": {"text": "No Diamonds","hover_event": {"action": "show_text","value": {"text": "Disables diamonds spawning on this tile."}}},"initial": $(no_diamond)},{"type": "minecraft:boolean","key": "no_warp","label": {"text": "No Warp","hover_event": {"action": "show_text","value": "Disables warping to this tile by unintentional means eg. Whirlwind Tiles. You can still warp to the tile by occupying it, or when specifically warped to."}},"initial": $(no_warp)},{"type": "minecraft:boolean","key": "no_passage","label": {"text": "No Passage","hover_event": {"action": "show_text","value": "Passing over this tile immediately ends your turn, landing you on this tile."}},"initial": $(no_passage)},{type:"minecraft:text",key:"other",label:{"text":"Other tags \u00a7c(WARNING)\u00a7r:","hover_event":{"action": "show_text","value": "Don't add tags willy nilly! Make sure it's not a tag already in use by functions by adding + in front, like [\"+tag\"]"}},"initial":'$(other)',max_length:1024}],"yes": {"label": "Confirm changes","action": {"type": "minecraft:dynamic/run_command","template": "function mineparty:editor/tiles/edit_tags {no_diamond:\"\u0024(no_diamond)\",no_passage:\"\u0024(no_passage)\",no_warp:\"\u0024(no_warp)\",other:'\u0024(other)',UUID:$(UUID)}"}},"no":{"label": "Cancel"}}