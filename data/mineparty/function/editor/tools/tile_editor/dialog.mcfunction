$dialog show @s {"type": "minecraft:multi_action","title": {"text": "Tile Editor"},"inputs": [{"type": "minecraft:text","key": "map","label": "Map","initial": "$(map)"},{"type": "minecraft:text","key": "name","label": "Name","initial": "$(name)"},{"type": "minecraft:text","key": "type","label": "Type","initial": "$(type)"},{"type": "minecraft:text","key": "block","label": "Block","initial": "$(block)"}],"actions": [{"label": "Confirm changes","action": {"type": "minecraft:dynamic/run_command","template": "function mineparty:editor/tiles/edit_tile {type:\"\u0024(type)\",name:\"\u0024(name)\",block:\"\u0024(block)\",map:\"\u0024(map)\",UUID:$(UUID)}"}},{"label": "Copy this tile","action": {"type": "minecraft:run_command","command": "function mineparty:editor/tiles/get_tile {type:\"$(type)\",name:\"$(name)\",block:\"$(block)\",map:\"$(map)\"}"}},{"label": "Get brush","action": {"type": "minecraft:dynamic/run_command","template": "function mineparty:editor/tools/tile_brush/give {type:\"\u0024(type)\",name:\"\u0024(name)\",block:\"\u0024(block)\",map:\"\u0024(map)\"}"}},{"label": "\u00a7cDelete this tile","action": {"type": "minecraft:run_command","command": "execute as @n[nbt={UUID:$(UUID)}] at @s run function mineparty:editor/tiles/delete_tile"}},{"label": "Cancel"}]}