execute if data entity @n[tag=tile] {data:{special:{direction:"south"}}} as @e[tag=shop_stall] at @s run tp @s ~ ~ ~ ~90 ~
execute if data entity @n[tag=tile] {data:{special:{direction:"west"}}} as @e[tag=shop_stall] at @s run tp @s ~ ~ ~ ~180 ~
execute if data entity @n[tag=tile] {data:{special:{direction:"north"}}} as @e[tag=shop_stall] at @s run tp @s ~ ~ ~ ~-90 ~

execute unless data entity @n[tag=tile] data.special.direction as @n[tag=tile] at @s run particle end_rod ~2 ~ ~ 1 0 1 0.1 700
execute if data entity @n[tag=tile] {data:{special:{direction:"east"}}} as @n[tag=tile] at @s run particle end_rod ~2 ~ ~ 1 0 1 0.1 700
execute if data entity @n[tag=tile] {data:{special:{direction:"south"}}} as @n[tag=tile] at @s run particle end_rod ~ ~ ~2 1 0 1 0.1 700
execute if data entity @n[tag=tile] {data:{special:{direction:"west"}}} as @n[tag=tile] at @s run particle end_rod ~-2 ~ ~ 1 0 1 0.1 700
execute if data entity @n[tag=tile] {data:{special:{direction:"north"}}} as @n[tag=tile] at @s run particle end_rod ~ ~ ~-2 1 0 1 0.1 700