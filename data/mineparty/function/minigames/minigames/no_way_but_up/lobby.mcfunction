# Teleport everyone to lobby
execute at @n[tag=nwbu_lobby] run tp @a ~ ~ ~

# Give rulebook
give @a[tag=!not_playing] written_book[written_book_content={title:"No Way But Up Rulebook",author:"Spunkton",pages:[["",{"text":"No Way But Up","bold":true},{"text":"\n\n> Summary","color":"red","click_event":{"action":"change_page","page":2}},{"text":"\n> Clouds","color":"gold","click_event":{"action":"change_page","page":3}},{"text":"\n> Tips","color":"dark_blue","click_event":{"action":"change_page","page":4}},{"text":"\n> Other info","color":"dark_purple","click_event":{"action":"change_page","page":5}},{"text":"\n\n[READY]","color":"dark_green","bold":true,"click_event":{"action":"run_command","command":"trigger ready set 1"}}],["",{"text":"Summary","bold":true},{"text":"\n\nSurvive as long as possible by parkouring on clouds.\n\nClouds gradually spawn faster and further, so stay alert!"},{"text":"\n\nThe last to survive wins."}],["",{"text":"Clouds","bold":true},{"text":"\n\nAs clouds spawn, the oldest clouds darken and then die out.\n\nThe highest cloud is marked with a glowing outline.\n\nClouds are walk-through on the sides, so don't worry about getting stuck!"}],["",{"text":"Tips","bold":true},{"text":"\n\n- This game is about survival, not about getting as high as possible. Don't take jumps you can't make!\n\n- Turn on volume so you can hear where the clouds spawn."}],["",{"text":"Other info","bold":true},{"text":"\n\n- Fall damage, collision, and attacking is turned off.\n\n- Everyone is invisible."}]]},custom_data={rulebook:true},custom_name={"italic":false,"text":"Rulebook"},tooltip_display={hidden_components:["written_book_content"]},item_model="knowledge_book"] 1