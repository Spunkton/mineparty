give @a[tag=!not_playing] written_book[written_book_content={title:"Russian Roulette",author:"Spunkton",pages:[["",{"text":"Russian Roulette","bold":true},{"text":"\n\n> Summary","color":"red","click_event":{"action":"change_page","page":2}},{"text":"\n> Tips","color":"dark_blue","click_event":{"action":"change_page","page":3}},{"text":"\n> Other info","color":"dark_purple","click_event":{"action":"change_page","page":4}},{"text":"\n\n[READY]","color":"dark_green","bold":true,"click_event":{"action":"run_command","command":"trigger ready set 1"}}],["",{"text":"Summary","bold":true},{"text":"\n\nEach round, a single lethal bullet is put in the "},{"text":"barrel","bold":true,"hover_event":{"action":"show_text","value":[{"text":"The 6 circles that spin at the start of the game (these are the primers/ bottoms of the bullets)."}]}},{"text":".\n\nPlayers take turns "},{"text":"shooting","bold":true,"hover_event":{"action":"show_text","value":[{"text":"Pressing the button."}]}}," themselves until a player dies, prompting a new round.",{"text":"\n\nThe last player standing wins."}],["",{"text":"Tips","bold":true},{"text":"\n\n- Just shoot. It's a gamble, don't think too hard about it."}],["",{"text":"Other info","bold":true},{"text":"\n\n- For hosts: You can press the button for other players. Only the player taking their turn is at risk.\n\n- You are unable to shoot if the revolver barrel is still animated."}]]},custom_data={rulebook:true},custom_name={"italic":false,"text":"Rulebook"},tooltip_display={hidden_components:["written_book_content"]},item_model="knowledge_book"] 1