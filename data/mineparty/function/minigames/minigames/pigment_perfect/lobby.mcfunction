# Teleport everyone to lobby
execute at @n[tag=pigment_perfect_lobby] run tp @a ~ ~ ~

# Give rulebook
give @a[tag=!not_playing] written_book[written_book_content={title:"Sulfurball",author:"Spunkton",pages:[["",{"text":"Pigment Perfect","bold":true},{"text":"\n\n> Summary","color":"red","click_event":{"action":"change_page","page":2}},{"text":"\n> Scoring","color":"gold","click_event":{"action":"change_page","page":3}},{"text":"\n> Items","color":"#FFE600","click_event":{"action":"change_page","page":4}},{"text":"\n> Tips","color":"dark_blue","click_event":{"action":"change_page","page":5}},{"text":"\n> Other info","color":"dark_purple","click_event":{"action":"change_page","page":6}},{"text":"\n\n[READY]","color":"dark_green","bold":true,"click_event":{"action":"run_command","command":"trigger ready set 1"}}],["",{"text":"Summary","bold":true},{"text":"\n\nTry and dye your armor as close to the "},{"text":"reference","bold":true,"hover_event":{"action":"show_text","value":[{"text":"The big armor stand."}]}}," as possible!",{"text":"\n\nYou start with all dyes and leather armor."}],["",{"text":"Scoring","bold":true},{"text":"\n\nEach armor piece is scored using distance in "},{"text":"CIELAB color space","color":"blue","bold":true,"underlined":true,"hover_event":{"action":"show_text","value":[{"text":"CIELAB measures how \"far\" away two colors are.\n(Click to open Wikipedia page.)"}]},"click_event":{"action":"open_url","url":"https://en.wikipedia.org/wiki/CIELAB_color_space"}},{"text":".\n\nThese distances are then added to each other to get your final score. The lowest score wins!"}],["",{"text":"Items","bold":true},{"text":"\n\nYou'll get a set of leather armor, and 64 of each dye.\n\nArmor does not need to worn for scoring, it can be anywhere in your inventory!\n\nThe cauldrons refill themselves."}],["",{"text":"Tips","bold":true},{"text":"\n\n- Some colors are impossible to reach (especially bright colors), so don't linger too long on one item.\n\n- Use the crafting tables for greater precision."}],["",{"text":"Other info","bold":true},{"text":"\n\n- PVP and collisions are off.\n\n- You have 60 "},{"text":"(+5)","bold":true,"hover_event":{"action":"show_text","value":[{"text":"Dressing up the mannquin takes 5 seconds, after which the timer starts."}]}},{"text":" seconds to finish your armor.\n\n- There is no spare armor or dye, so don't lose the ones you start with."}]]},custom_data={rulebook:true},custom_name={"italic":false,"text":"Rulebook"},tooltip_display={hidden_components:["written_book_content"]},item_model="knowledge_book"] 1