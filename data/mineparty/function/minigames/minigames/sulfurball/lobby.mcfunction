# Teleport everyone to lobby
execute at @n[tag=sulfurball_lobby] run tp @a ~ ~ ~

# Give rulebook
give @a[tag=!not_playing] written_book[written_book_content={title:"Sulfurball",author:"Spunkton",pages:[["",{"text":"Sulfurball","bold":true},{"text":"\n\n> Summary","color":"red","click_event":{"action":"change_page","page":2}},{"text":"\n> Points","color":"gold","click_event":{"action":"change_page","page":3}},{"text":"\n> Items","color":"#FFE600","click_event":{"action":"change_page","page":4}},{"text":"\n> Golden goal","color":"green","click_event":{"action":"change_page","page":5}},{"text":"\n> Tips","color":"dark_blue","click_event":{"action":"change_page","page":6}},{"text":"\n> Other info","color":"dark_purple","click_event":{"action":"change_page","page":7}},{"text":"\n\n[READY]","color":"dark_green","bold":true,"click_event":{"action":"run_command","command":"trigger ready set 1"}}],["",{"text":"Summary","bold":true},{"text":"\n\nHit the sulfur cube into the goal of the opponents, from the "},{"text":"front","bold":true,"hover_event":{"action":"show_text","value":[{"text":"1 Point."}]}}," or from the ",{"text":"top","bold":true,"hover_event":{"action":"show_text","value":[{"text":"2 Points!"}]}},{"text":"!\n\nThe team with the most points at the end wins! Extra time for a "},{"text":"golden goal","bold":true,"hover_event":{"action":"show_text","value":[{"text":"A goal that immediately wins the game."}]}}," is given if needed."],["",{"text":"Points","bold":true},{"text":"\n\nYou get 1 point for scoring  from the front, and 3 points for \"dunking\" into the hole at the top of the goal.\n\nTeams return to their half after each goal, and the team who got scored on recieves the ball."}],["",{"text":"Items","bold":true},{"text":"\n\nYou get 3 items:\n\n"},{"text":"Paddle:","bold":true,"hover_event":{"action":"show_item","id":"minecraft:wooden_sword","count":1,"components":{"minecraft:enchantments":{"knockback":1,"lunge":1},"minecraft:unbreakable":{},"minecraft:custom_name":{"color":"white","italic":false,"text":"Paddle"}}}},{"text":" Used to hit the ball. Has a cooldown!\n\n"},{"text":"Hook:","bold":true,"hover_event":{"action":"show_item","id":"minecraft:fishing_rod","count":1,"components":{"minecraft:unbreakable":{},"minecraft:custom_name":{"color":"white","italic":false,"text":"Hook"}}}},{"text":" A simple fishing rod. Has more reach than usual.\n\n"},{"text":"Wind Charge:","bold":true,"hover_event":{"action":"show_item","id":"minecraft:wind_charge","count":1}}," Has a longer cooldown."],["",{"text":"Golden goal","bold":true},{"text":"\n\nIf neither team wins after 2 minutes, an extra minute of overtime will be given.\n\nWhoever scores first in overtime wins!\n\nOvertime starts immediately, teams are not sent to their halves."}],["",{"text":"Tips","bold":true},{"text":"\n\n- Hitting the ball low sends it up! Use this to dunk.\n\n- You can walk into the sulfur ball, or hit it with your fist for more control.\n\n- You can hit other players..."}],["",{"text":"Other info","bold":true},{"text":"\n\n- You cannot take damage (Resistance V).\n\n- The sulfur cube has ever so slightly less gravity (base 0.07).\n\n- Wind charge cooldown is 4 seconds (long!)."}]]},custom_data={rulebook:true},custom_name={"italic":false,"text":"Rulebook"},tooltip_display={hidden_components:["written_book_content"]},item_model="knowledge_book"] 1