# Indicators for minigame components
execute as @e[type=marker,tag=minigame_spawn] at @s if entity @p[predicate=mineparty:editor/holding_tool,distance=..32] unless entity @n[tag=minigame_spawn_indicator,distance=..1] run summon item_display ~ ~ ~ {transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0.5f,-0.2f],scale:[0.4f,0.4f,0.4f]},Tags:["minigame_spawn_indicator","minigame_indicator"],item:{id:"minecraft:red_bed",count:1}}
execute as @e[type=marker,tag=minigame_start] at @s if entity @p[predicate=mineparty:editor/holding_tool,distance=..32] unless entity @n[tag=minigame_start_indicator,distance=..1] run summon item_display ~ ~ ~ {billboard:"vertical",transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],translation:[0f,0.5f,0f],scale:[0.5f,0.5f,0.5f]},Tags:["minigame_start_indicator","minigame_indicator"],item:{id:"minecraft:ender_pearl",count:1}}
