# Remove indicator if no editor nearby
execute as @e[tag=minigame_indicator] at @s unless entity @p[predicate=mineparty:editor/holding_tool,distance=..32] run kill @s
execute as @e[tag=minigame_indicator] at @s unless entity @n[type=marker,distance=...1] run kill @s